    <comps>
      <li Class="HeirsOfEarth.HediffCompProperties_HeirsDoctrine" />
    </comps>
    <stages>
      <li>
        <label>mountain stride</label>
        <statOffsets>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
          <MoveSpeed>0.3</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
