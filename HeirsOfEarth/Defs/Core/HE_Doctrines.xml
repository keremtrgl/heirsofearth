    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HeirsOfEarth.HediffCompProperties_HeirsDoctrine" />
    </comps>
    <stages>
      <li>
        <label>vanguard's speed</label>
        <statOffsets>
          <MoveSpeed>0.8</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>HE_Doctrine_Pars</defName>
    <label>cavalry wings drill</label>
    <description>The armies of Pars attack on the wings: several swift groups at once, used to fighting from the saddle and closing in fast.

It lasts while the raider fights for the raid.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.85, 0.66, 0.36)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <minSeverity>0.001</minSeverity>
    <maxSeverity>1</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HeirsOfEarth.HediffCompProperties_HeirsDoctrine" />
    </comps>
    <stages>
      <li>
        <label>rider's charge</label>
        <statOffsets>
          <MoveSpeed>0.6</MoveSpeed>
          <MeleeHitChance>2</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>HE_Doctrine_Inti</defName>
    <label>mountain sappers drill</label>
    <description>The road builders of the Andes go through rock rather than around it. Inti raiders dig toward your walls and throw stones with mountain-trained aim.

It lasts while the raider fights for the raid.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.85, 0.66, 0.36)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
