  <ThingDef ParentName="BenchBase">
    <defName>HE_CultureTable</defName>
    <label>culture table</label>
    <description>A long table covered with tools, lenses and notebooks. Here scholars take apart the goods of the heir nations to learn how they think and work. Each studied item gives Culture Knowledge of its nation.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_CultureTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,1.6)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costList>
      <Cloth>20</Cloth>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>2400</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1</Flammability>
      <Cleanliness>-1</Cleanliness>
      <Beauty>2</Beauty>
    </statBases>
    <size>(3,1)</size>
    <rotatable>false</rotatable>
    <designationCategory>HE_Heritage</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>HE_CultureTable</li>
    </researchPrerequisites>
    <recipes>
      <li>HE_StudyCulture</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>0</heatPerTickWhileWorking>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>
