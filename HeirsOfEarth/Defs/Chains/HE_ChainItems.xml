<Defs>
  <HediffDef>
    <defName>HE_Rallied</defName>
    <label>rallied</label>
    <description>Inspired by an ancient artifact. Fights harder, feels less pain and keeps a steadier mind.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.95, 0.80, 0.40)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.8</painFactor>
        <statOffsets>
          <MeleeHitChance>3</MeleeHitChance>
          <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
