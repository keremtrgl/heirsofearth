<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>HE_Faction_Tianxia</defName>
    <label>Celestial Tianxia</label>
    <description>The realm of all under heaven, heir of the colony ship Kunlun. Its scholar-officials govern a vast and patient people, and its caravans carry tea, silk and porcelain along the silk roads.</description>
    <fixedName>Celestial Tianxia</fixedName>
    <pawnSingular>Tianxia subject</pawnSingular>
    <pawnsPlural>Tianxia people</pawnsPlural>
    <leaderTitle>emperor</leaderTitle>
    <categoryTag>HE_Tianxia</categoryTag>
    <listOrderPriority>32</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>60</configurationListOrderPriority>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <humanlikeFaction>true</humanlikeFaction>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>HE_Tianxia_Militia</basicMemberKind>
    <fixedLeaderKinds>
      <li>HE_Tianxia_Emperor</li>
    </fixedLeaderKinds>
    <factionIconPath>HeirsOfEarth/UI/HE_Tianxia</factionIconPath>
    <settlementTexturePath>HeirsOfEarth/World/HE_Settlement_Tianxia</settlementTexturePath>
    <colorSpectrum>
      <li>(0.62, 0.14, 0.12)</li>
      <li>(0.85, 0.66, 0.20)</li>
    </colorSpectrum>
    <settlementNameMaker>HE_Names_Tianxia_Settlement</settlementNameMaker>
    <backstoryFilters>
      <li>
        <categories>
          <li>HE_Tianxia</li>
        </categories>
        <commonality>1</commonality>
      </li>
    </backstoryFilters>
    <caravanTraderKinds>
      <li>HE_Tianxia_Caravan</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>HE_Tianxia_Caravan</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>HE_Tianxia_Settlement</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70,50)</li>
        <li>(700,100)</li>
        <li>(1300,150)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <earliestRaidDays>30</earliestRaidDays>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <HE_Tianxia_Militia>14</HE_Tianxia_Militia>
          <HE_Tianxia_Crossbowman>10</HE_Tianxia_Crossbowman>
          <HE_Tianxia_Guard>6</HE_Tianxia_Guard>
          <HE_Tianxia_General>2</HE_Tianxia_General>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <HE_Tianxia_Militia>8</HE_Tianxia_Militia>
          <HE_Tianxia_Scholar>6</HE_Tianxia_Scholar>
          <HE_Tianxia_Crossbowman>3</HE_Tianxia_Crossbowman>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <HE_Tianxia_Merchant>1</HE_Tianxia_Merchant>
        </traders>
        <carriers>
          <Yak>4</Yak>
          <Horse>4</Horse>
          <Muffalo>1</Muffalo>
        </carriers>
        <guards>
          <HE_Tianxia_Crossbowman>8</HE_Tianxia_Crossbowman>
          <HE_Tianxia_Guard>6</HE_Tianxia_Guard>
          <HE_Tianxia_Militia>4</HE_Tianxia_Militia>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <HE_Tianxia_Militia>12</HE_Tianxia_Militia>
          <HE_Tianxia_Crossbowman>10</HE_Tianxia_Crossbowman>
          <HE_Tianxia_Guard>5</HE_Tianxia_Guard>
          <HE_Tianxia_General>2</HE_Tianxia_General>
          <HE_Tianxia_Scholar>3</HE_Tianxia_Scholar>
          <HE_Tianxia_Emperor>1</HE_Tianxia_Emperor>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
  <FactionDef ParentName="PlayerFactionBase">
    <defName>HE_Player_Tianxia</defName>
    <label>Tianxia settlers</label>
    <description>A small household of Tianxia settlers sent to open a new frontier for the empire.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>HE_Tianxia_Colonist</basicMemberKind>
    <pawnSingular>colonist</pawnSingular>
    <pawnsPlural>colonists</pawnsPlural>
    <techLevel>Medieval</techLevel>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>HE_Names_Tianxia_Settlement</settlementNameMaker>
    <backstoryFilters>
      <li>
        <categories>
          <li>HE_Tianxia</li>
        </categories>
        <commonality>0.85</commonality>
      </li>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.15</commonality>
      </li>
    </backstoryFilters>
    <factionIconPath>HeirsOfEarth/UI/HE_Tianxia</factionIconPath>
    <startingResearchTags>
      <li>TribalStart</li>
    </startingResearchTags>
    <colorSpectrum>
      <li>(0.62, 0.14, 0.12)</li>
    </colorSpectrum>
  </FactionDef>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>HE_Start_Tianxia</defName>
    <label>Heirs of Tianxia</label>
    <description>Five settlers of Tianxia open a new frontier for the empire. They start with the Tianxia heritage, a jian, a bundle of silk and tea, rice and the bamboo annals.</description>
    <scenario>
      <summary>Five Tianxia settlers open a new frontier. Tianxia heritage.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>HE_Player_Tianxia</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>5</pawnCount>
          <pawnChoiceCount>10</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>
        <li Class="HeirsOfEarth.ScenPart_HeirsHeritage">
          <def>HE_Heritage</def>
          <nation>HE_Tianxia</nation>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Tianxia_Jian</thingDef>
          <count>1</count>
          <stuff>Steel</stuff>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Tianxia_Silk</thingDef>
          <count>6</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Tianxia_TeaBrick</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>400</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RawRice</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>35</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Cloth</thingDef>
          <count>60</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Tianxia_Archive</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>1</count>
          <bondToRandomPlayerPawnChance>0.5</bondToRandomPlayerPawnChance>
          <animalKind>Yak</animalKind>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>250</count>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>HE_StartTianxiaDialog</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
