<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>HE_Faction_Yamato</defName>
    <label>Yamato Shogunate</label>
    <description>The clans of Yamato, heirs of the colony ship Takamagahara. Their warrior houses serve the shogun with unbending loyalty, and their smiths fold steel into the finest blades in the world.</description>
    <fixedName>Yamato Shogunate</fixedName>
    <pawnSingular>Yamato</pawnSingular>
    <pawnsPlural>Yamato people</pawnsPlural>
    <leaderTitle>shogun</leaderTitle>
    <categoryTag>HE_Yamato</categoryTag>
    <listOrderPriority>32</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>60</configurationListOrderPriority>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <humanlikeFaction>true</humanlikeFaction>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>HE_Yamato_Ashigaru</basicMemberKind>
    <fixedLeaderKinds>
      <li>HE_Yamato_Shogun</li>
    </fixedLeaderKinds>
    <factionIconPath>HeirsOfEarth/UI/HE_Yamato</factionIconPath>
    <settlementTexturePath>HeirsOfEarth/World/HE_Settlement_Yamato</settlementTexturePath>
    <colorSpectrum>
      <li>(0.20, 0.22, 0.33)</li>
      <li>(0.62, 0.16, 0.16)</li>
    </colorSpectrum>
    <settlementNameMaker>HE_Names_Yamato_Settlement</settlementNameMaker>
    <backstoryFilters>
      <li>
        <categories>
          <li>HE_Yamato</li>
        </categories>
        <commonality>1</commonality>
      </li>
    </backstoryFilters>
    <caravanTraderKinds>
      <li>HE_Yamato_Caravan</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>HE_Yamato_Caravan</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>HE_Yamato_Settlement</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70,50)</li>
        <li>(700,100)</li>
        <li>(1300,150)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <earliestRaidDays>30</earliestRaidDays>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <HE_Yamato_Ashigaru>12</HE_Yamato_Ashigaru>
          <HE_Yamato_Samurai>8</HE_Yamato_Samurai>
          <HE_Yamato_Yumitori>8</HE_Yamato_Yumitori>
          <HE_Yamato_Hatamoto>2</HE_Yamato_Hatamoto>
          <HE_Yamato_Monk>2</HE_Yamato_Monk>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <HE_Yamato_Ashigaru>10</HE_Yamato_Ashigaru>
          <HE_Yamato_Monk>6</HE_Yamato_Monk>
          <HE_Yamato_Samurai>4</HE_Yamato_Samurai>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <HE_Yamato_Akindo>1</HE_Yamato_Akindo>
        </traders>
        <carriers>
          <Horse>5</Horse>
          <Yak>3</Yak>
          <Muffalo>1</Muffalo>
        </carriers>
        <guards>
          <HE_Yamato_Samurai>10</HE_Yamato_Samurai>
          <HE_Yamato_Ashigaru>6</HE_Yamato_Ashigaru>
          <HE_Yamato_Yumitori>5</HE_Yamato_Yumitori>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <HE_Yamato_Ashigaru>12</HE_Yamato_Ashigaru>
          <HE_Yamato_Samurai>8</HE_Yamato_Samurai>
          <HE_Yamato_Yumitori>8</HE_Yamato_Yumitori>
          <HE_Yamato_Hatamoto>3</HE_Yamato_Hatamoto>
          <HE_Yamato_Monk>3</HE_Yamato_Monk>
          <HE_Yamato_Shogun>1</HE_Yamato_Shogun>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
  <FactionDef ParentName="PlayerFactionBase">
    <defName>HE_Player_Yamato</defName>
    <label>Yamato settlers</label>
    <description>A small household of Yamato settlers clearing new land for their clan.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>HE_Yamato_Colonist</basicMemberKind>
    <pawnSingular>colonist</pawnSingular>
    <pawnsPlural>colonists</pawnsPlural>
    <techLevel>Medieval</techLevel>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>HE_Names_Yamato_Settlement</settlementNameMaker>
    <backstoryFilters>
      <li>
        <categories>
          <li>HE_Yamato</li>
        </categories>
        <commonality>0.85</commonality>
      </li>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.15</commonality>
      </li>
    </backstoryFilters>
    <factionIconPath>HeirsOfEarth/UI/HE_Yamato</factionIconPath>
    <startingResearchTags>
      <li>TribalStart</li>
    </startingResearchTags>
    <colorSpectrum>
      <li>(0.20, 0.22, 0.33)</li>
    </colorSpectrum>
  </FactionDef>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>HE_Start_Yamato</defName>
    <label>Heirs of Yamato</label>
    <description>Five settlers of a Yamato clan clear new land in the shogun's name. They start with the Yamato heritage, a yari, a yumi, rice and a case of clan scrolls.</description>
    <scenario>
      <summary>Five Yamato settlers clear new land. Yamato heritage.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>HE_Player_Yamato</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>5</pawnCount>
          <pawnChoiceCount>10</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>
        <li Class="HeirsOfEarth.ScenPart_HeirsHeritage">
          <def>HE_Heritage</def>
          <nation>HE_Yamato</nation>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Yamato_Yari</thingDef>
          <count>1</count>
          <stuff>Steel</stuff>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Yamato_Yumi</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>400</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RawRice</thingDef>
          <count>250</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>35</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Cloth</thingDef>
          <count>80</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HE_Yamato_Archive</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>1</count>
          <bondToRandomPlayerPawnChance>0.5</bondToRandomPlayerPawnChance>
          <animalKind>Horse</animalKind>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>250</count>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>HE_StartYamatoDialog</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
