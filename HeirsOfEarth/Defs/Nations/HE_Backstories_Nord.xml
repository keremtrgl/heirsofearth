    <defName>HE_Nord_BS_Thrall</defName>
    <title>thrall's child</title>
    <titleShort>thrall</titleShort>
    <description>[PAWN_nameDef] was born unfree and worked in the fields from the day [PAWN_pronoun] could carry a basket, until a kind jarl set [PAWN_objective] free.</description>
    <slot>Childhood</slot>
    <spawnCategories>
      <li>HE_Nord</li>
