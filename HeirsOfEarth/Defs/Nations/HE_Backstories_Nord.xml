    <title>mead hall child</title>
    <titleShort>hall child</titleShort>
    <description>[PAWN_nameDef] grew up in the jarl's hall, carrying horns of mead to warriors and listening to their boasts late into the night.</description>
    <slot>Childhood</slot>
    <spawnCategories>
      <li>HE_Nord</li>
    </spawnCategories>
