    <title>fjord child</title>
    <titleShort>fjord child</titleShort>
    <description>[PAWN_nameDef] grew up fishing from small boats and swimming in water so cold it stopped the breath.</description>
    <slot>Childhood</slot>
    <spawnCategories>
      <li>HE_Nord</li>
    </spawnCategories>
    <skillGains>
