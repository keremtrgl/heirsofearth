<Defs>
  <BackstoryDef>
    <defName>HE_Hellas_BS_Hoplite</defName>
    <title>citizen hoplite</title>
    <titleShort>hoplite</titleShort>
    <description>Like every free citizen, [PAWN_nameDef] bought [PAWN_possessive] own shield and spear and took [PAWN_possessive] place in the line when the city called. Between wars [PAWN_pronoun] worked a small farm of olives and barley.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Hellas</li>
    </spawnCategories>
    <skillGains>
      <Melee>6</Melee>
      <Plants>3</Plants>
      <Construction>1</Construction>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Hellas_BS_Physician</defName>
    <title>Asklepian physician</title>
    <titleShort>physician</titleShort>
    <description>[PAWN_nameDef] trained at a temple of healing, where the sick slept in quiet halls and the physicians wrote down every symptom. [PAWN_pronoun] swore to do no harm and has kept the oath.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Hellas</li>
    </spawnCategories>
    <skillGains>
      <Medicine>8</Medicine>
      <Intellectual>4</Intellectual>
    </skillGains>
    <requiredWorkTags>
      <li>Intellectual</li>
    </requiredWorkTags>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Hellas_BS_Philosopher</defName>
    <title>wandering philosopher</title>
    <titleShort>philosopher</titleShort>
    <description>[PAWN_nameDef] walked from city to city asking awkward questions in the market. Some paid to listen, some paid [PAWN_objective] to leave. [PAWN_pronoun] still believes no question should go unasked.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Hellas</li>
    </spawnCategories>
    <skillGains>
