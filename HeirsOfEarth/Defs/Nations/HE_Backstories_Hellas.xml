  <BackstoryDef>
    <defName>HE_Hellas_BS_Athlete</defName>
    <title>games champion</title>
    <titleShort>champion</titleShort>
    <description>[PAWN_nameDef] won the long race at the games and was given an olive wreath, a statue and free meals for life. [PAWN_pronoun] still trains every morning before dawn.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Hellas</li>
