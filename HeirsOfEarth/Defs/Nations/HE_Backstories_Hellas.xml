        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Hellas_BS_Sculptor</defName>
    <title>temple sculptor</title>
    <titleShort>sculptor</titleShort>
    <description>[PAWN_nameDef] spent years in the marble yards beside a great temple, carving gods and athletes so lifelike that visitors spoke to them.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
