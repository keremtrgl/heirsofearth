      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Kemet_BS_Mason</defName>
    <title>royal stonemason</title>
    <titleShort>mason</titleShort>
    <description>[PAWN_nameDef] worked in the quarry gangs that cut and dragged the great blocks. [PAWN_pronoun] can split granite with wooden wedges and water, and [PAWN_possessive] walls never lean.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Kemet</li>
