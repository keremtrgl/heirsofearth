<Defs>
  <BackstoryDef>
    <defName>HE_Kemet_BS_Farmer</defName>
    <title>river farmer</title>
    <titleShort>farmer</titleShort>
    <description>Every year [PAWN_nameDef] waited for the flood, then planted the black silt it left behind. [PAWN_pronoun] knows the weight of a good harvest by eye and the taste of a bad one by heart.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Kemet</li>
    </spawnCategories>
    <skillGains>
      <Plants>7</Plants>
      <Animals>2</Animals>
      <Construction>1</Construction>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Kemet_BS_Scribe</defName>
    <title>royal scribe</title>
    <titleShort>scribe</titleShort>
    <description>[PAWN_nameDef] sat cross-legged in the granary for years, counting sacks, copying letters and catching overseers who stole. Many people owe [PAWN_objective] favours; some owe [PAWN_objective] grudges.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Kemet</li>
    </spawnCategories>
    <skillGains>
      <Intellectual>7</Intellectual>
      <Social>4</Social>
    </skillGains>
