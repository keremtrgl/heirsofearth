  <BackstoryDef>
    <defName>HE_Kemet_BS_Charioteer</defName>
    <title>charioteer</title>
    <titleShort>charioteer</titleShort>
    <description>[PAWN_nameDef] drove a war chariot in the king's corps, a pair of horses in one hand and a bow in the other. [PAWN_pronoun] still talks to animals more gently than to people.</description>
    <slot>Adulthood</slot>
