    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Yamato</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Yamato_BS_TeaMaster</defName>
    <title>tea master</title>
    <titleShort>tea master</titleShort>
    <description>[PAWN_nameDef] served tea to lords and generals and listened to everything they said over the cups. A quiet word from [PAWN_objective] has settled more feuds than any sword.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Yamato</li>
