        <nation>HE_Yamato</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Yamato_BS_RiceFarmer</defName>
    <title>rice farmer</title>
    <titleShort>farmer</titleShort>
    <description>[PAWN_nameDef] spent every spring knee-deep in flooded paddies, planting seedlings one by one. [PAWN_pronoun] can read the weather in the colour of the morning sky.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
