      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Inti</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Inti_BS_Khipukamayuq</defName>
    <title>khipukamayuq</title>
    <titleShort>knot keeper</titleShort>
    <description>[PAWN_nameDef] kept the quipus of a whole province: every llama, every sack of maize and every soldier, tied in coloured knots. [PAWN_pronoun] can still read a cord by touch in the dark.</description>
