    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Pars_BS_Immortal</defName>
    <title>immortal guard</title>
    <titleShort>guard</titleShort>
    <description>[PAWN_nameDef] stood in the royal guard, one of the ten thousand whose number never falls. [PAWN_pronoun] learned to fight in a line, to obey without a word and to look splendid while doing it.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
    </spawnCategories>
    <skillGains>
      <Melee>7</Melee>
      <Shooting>3</Shooting>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Pars_BS_Dabir</defName>
    <title>court secretary</title>
    <titleShort>secretary</titleShort>
    <description>[PAWN_nameDef] wrote the satrap's letters in three scripts and read everyone else's. [PAWN_pronoun] knows which governor owes what to whom, and never says it aloud.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
    </spawnCategories>
    <skillGains>
