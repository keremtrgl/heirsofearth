      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Pars_BS_Astronomer</defName>
    <title>court astronomer</title>
    <titleShort>astronomer</titleShort>
    <description>[PAWN_nameDef] measured the stars from a palace roof, kept the calendar and was asked to read the future far more often than [PAWN_pronoun] wanted to.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
