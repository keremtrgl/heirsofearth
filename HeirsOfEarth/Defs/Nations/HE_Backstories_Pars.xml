<Defs>
  <BackstoryDef>
    <defName>HE_Pars_BS_PostRider</defName>
    <title>royal post rider</title>
    <titleShort>rider</titleShort>
    <description>[PAWN_nameDef] carried the royal post from station to station, changing horses at every one and sleeping in the saddle. [PAWN_pronoun] has crossed the whole satrapy more times than [PAWN_pronoun] can count.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
    </spawnCategories>
    <skillGains>
      <Animals>6</Animals>
      <Melee>2</Melee>
      <Social>2</Social>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Pars_BS_Weaver</defName>
    <title>carpet weaver</title>
    <titleShort>weaver</titleShort>
    <description>[PAWN_nameDef] knotted carpets in a workshop of twenty looms, a pattern of a thousand flowers held in [PAWN_possessive] head. A single carpet of [PAWN_possessive] hangs in the satrap's hall.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
    </spawnCategories>
    <skillGains>
      <Crafting>8</Crafting>
      <Artistic>4</Artistic>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </BackstoryDef>
  <BackstoryDef>
    <defName>HE_Pars_BS_Gardener</defName>
    <title>paradise gardener</title>
    <titleShort>gardener</titleShort>
    <description>[PAWN_nameDef] kept a royal garden: four beds, four channels, a thousand roses and the satrap's favourite pomegranate tree, which [PAWN_pronoun] talks to.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
    </spawnCategories>
    <skillGains>
