  <BackstoryDef>
    <defName>HE_Pars_BS_Qanat</defName>
    <title>qanat digger</title>
    <titleShort>digger</titleShort>
    <description>[PAWN_nameDef] dug water tunnels under the mountains by lamplight, reading the slope by a plumb line and the air by the flame. [PAWN_pronoun] is not afraid of the dark or of hard rock.</description>
    <slot>Adulthood</slot>
    <spawnCategories>
      <li>HE_Pars</li>
    </spawnCategories>
    <skillGains>
      <Mining>7</Mining>
      <Construction>4</Construction>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
    <modExtensions>
