<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>HE_Yamato_Archive</defName>
    <label>Yamato scroll case</label>
    <description>A lacquered case of hand-painted scrolls: clan genealogies, sword-making records and poems about the seasons. Studying it at a culture table teaches a great deal about Yamato.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Items/HE_Yamato_Archive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>220</MarketValue>
      <Mass>0.6</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>HE_YamatoGoods</li>
    </tradeTags>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Yamato</nation>
        <knowledge>25</knowledge>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
