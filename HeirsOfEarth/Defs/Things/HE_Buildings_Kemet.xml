<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Kemet_Obelisk</defName>
    <label>obelisk</label>
    <description>A single needle of dressed stone covered in carved columns of signs and capped with a gilded point that shines at sunrise.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_Obelisk</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,2.4)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>160</costStuffCount>
    <costList>
      <Gold>5</Gold>
    </costList>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>22</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Kemet_Obelisk</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Kemet_SenetTable</defName>
    <label>senet table</label>
    <description>A low table of ebony and ivory with a board of thirty squares and a drawer for the pieces. Two colonists sit at it to play.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_SenetTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>20</Mass>
      <Beauty>4</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Kemet_Senet</li>
    </researchPrerequisites>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <JobDef>
    <defName>HE_PlaySenet</defName>
    <driverClass>JobDriver_SitFacingBuilding</driverClass>
    <reportString>playing senet.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>2</joyMaxParticipants>
    <joyKind>Gaming_Cerebral</joyKind>
    <joySkill>Intellectual</joySkill>
    <joyXpPerTick>0.002</joyXpPerTick>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>
  <JoyGiverDef>
    <defName>HE_Senet</defName>
    <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
    <baseChance>3</baseChance>
    <requireChair>false</requireChair>
    <thingDefs>
      <li>HE_Kemet_SenetTable</li>
    </thingDefs>
    <jobDef>HE_PlaySenet</jobDef>
    <joyKind>Gaming_Cerebral</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>
  <ThingDef ParentName="BenchBase">
    <defName>HE_Kemet_PapyrusWorkshop</defName>
    <label>papyrus workshop</label>
    <description>A reed-splitting table, a beating stone and drying racks. It turns dried grass and reeds into papyrus sheets.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_PapyrusWorkshop</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.15</staticSunShadowHeight>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <stuffCategories>
      <li>Stony</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.4</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>2200</WorkToBuild>
      <MaxHitPoints>140</MaxHitPoints>
      <Flammability>1</Flammability>
      <Cleanliness>-2</Cleanliness>
      <Mass>25</Mass>
    </statBases>
    <size>(2,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>HE_Kemet_Papyrus</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <RecipeDef>
    <defName>HE_Kemet_MakePapyrus</defName>
    <label>make papyrus</label>
    <description>Split, lay and beat 25 hay into 10 sheets of papyrus.</description>
    <jobString>Making papyrus.</jobString>
    <workAmount>1400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HE_Kemet_Papyrus>10</HE_Kemet_Papyrus>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>HE_Kemet_PapyrusWorkshop</li>
    </recipeUsers>
    <researchPrerequisite>HE_Kemet_Papyrus</researchPrerequisite>
  </RecipeDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Kemet_Sphinx</defName>
    <label>sphinx</label>
    <description>A lion with the head of a king, wearing the striped royal headcloth, carved to keep watch over a gate or a tomb. Kemet says its builders still dream behind its eyes.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_Sphinx</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.2,1.55)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.6</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>240</costStuffCount>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>20</Mass>
      <Beauty>34</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Kemet_ChildrenOfSun</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Kemet_LotusLamp</defName>
    <label>lotus lamp</label>
    <description>A bronze stand crowned with an open lotus flower that holds an oil flame. The lotus closes at night and opens at dawn, and so does the light of Kemet.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_LotusLamp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.56)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>6</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Kemet_Scribes</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>1.2</fuelConsumptionRate>
        <fuelCapacity>12</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.22</fireSize>
        <offset>(0,0,0.5)</offset>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(255,190,110,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>HE_Kemet_ArcherPylon_Gun</defName>
    <label>pylon bows</label>
    <description>The turning top of the archer pylon.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_ArcherPylon_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.5</AccuracyTouch>
      <AccuracyShort>0.62</AccuracyShort>
      <AccuracyMedium>0.5</AccuracyMedium>
      <AccuracyLong>0.34</AccuracyLong>
      <RangedWeapon_Cooldown>4.8</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>30</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>HE_Arrow_Pylon</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>28.9</range>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <burstShotCount>4</burstShotCount>
        <soundCast>Bow_Recurve</soundCast>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Kemet_ArcherPylon</defName>
    <label>archer pylon</label>
    <description>A sloped sandstone tower top painted with blue bands, where four composite bows on a turning stand shoot together. The volley is quick but the arrows are light. Wood for new arrows: one log makes two.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Kemet_ArcherPylon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <WorkToBuild>8500</WorkToBuild>
      <Mass>60</Mass>
      <Beauty>-4</Beauty>
      <ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <WoodLog>90</WoodLog>
      <BlocksSandstone>60</BlocksSandstone>
      <Steel>30</Steel>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>HE_Kemet_ArcherPylon_Gun</turretGunDef>
      <turretBurstCooldownTime>4.8</turretBurstCooldownTime>
      <turretTopDrawSize>2</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>HE_Kemet_ArcherPylon</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Arrows</fuelLabel>
        <fuelGizmoLabel>Arrows</fuelGizmoLabel>
        <outOfFuelMessage>Needs wood for arrows</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>60</fuelCapacity>
        <fuelMultiplier>2</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
