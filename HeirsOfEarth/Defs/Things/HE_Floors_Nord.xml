    <texturePath>HeirsOfEarth/Terrain/HE_Nord_Slate</texturePath>
    <pathCost>0</pathCost>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Beauty>1</Beauty>
      <Cleanliness>0.2</Cleanliness>
    </statBases>
    <costList>
      <BlocksSlate>3</BlocksSlate>
    </costList>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Nord_Longhouse</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <uiOrder>2400</uiOrder>
  </TerrainDef>
  <TerrainDef ParentName="FloorBase">
    <defName>HE_Nord_CarvedBoards</defName>
    <label>carved boards</label>
    <description>Heavy oak boards with knotwork carved into them by the hall's craftsmen during the long winters.</description>
    <texturePath>HeirsOfEarth/Terrain/HE_Nord_CarvedBoards</texturePath>
    <pathCost>0</pathCost>
    <statBases>
      <WorkToBuild>1100</WorkToBuild>
      <Beauty>2</Beauty>
      <Cleanliness>0.2</Cleanliness>
    </statBases>
    <costList>
      <WoodLog>4</WoodLog>
    </costList>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Nord_Runes</li>
