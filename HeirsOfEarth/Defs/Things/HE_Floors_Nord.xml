<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TerrainDef ParentName="FloorBase">
    <defName>HE_Nord_Planks</defName>
    <label>split plank floor</label>
    <description>Wide planks split from pine logs and fitted together. Warm underfoot.</description>
    <texturePath>HeirsOfEarth/Terrain/HE_Nord_Planks</texturePath>
    <pathCost>0</pathCost>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Beauty>1</Beauty>
      <Cleanliness>0.2</Cleanliness>
    </statBases>
    <costList>
      <WoodLog>3</WoodLog>
    </costList>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Nord_Planks</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <uiOrder>2400</uiOrder>
  </TerrainDef>
  <TerrainDef ParentName="FloorBase">
    <defName>HE_Nord_Slate</defName>
    <label>slate flagstones</label>
