    <graphicData>
      <texPath>HeirsOfEarth/Items/HE_Inti_Archive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>220</MarketValue>
      <Mass>0.6</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>HE_IntiGoods</li>
    </tradeTags>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Inti</nation>
        <knowledge>25</knowledge>
      </li>
    </modExtensions>
  </ThingDef>
