<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MealCooked">
    <defName>HE_Roma_Puls</defName>
    <label>puls</label>
    <description>A thick porridge of grain and beans with olive oil and herbs. The legions marched on it for centuries.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Items/HE_Roma_Puls</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>20</MarketValue>
      <WorkToMake>500</WorkToMake>
      <Nutrition>0.9</Nutrition>
      <Mass>0.44</Mass>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFineMeal</tasteThought>
      <optimalityOffsetFeedingAnimals>-25</optimalityOffsetFeedingAnimals>
    </ingestible>
    <tradeTags>
      <li>HE_RomaGoods</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>4</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Roma</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <RecipeDef ParentName="CookMealBase">
    <defName>HE_Cook_Roma_Puls</defName>
    <label>cook puls</label>
    <description>Cook puls.</description>
    <jobString>Cooking puls.</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>FoodRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>FoodRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <HE_Roma_Puls>1</HE_Roma_Puls>
    </products>
    <workSkill>Cooking</workSkill>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <researchPrerequisite>HE_Roma_Garum</researchPrerequisite>
    <recipeUsers>
      <li>FueledStove</li>
      <li>ElectricStove</li>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>
