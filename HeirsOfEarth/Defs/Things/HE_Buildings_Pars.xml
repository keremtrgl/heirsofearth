<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Pars_Garden</defName>
    <label>paradise garden</label>
    <description>A small walled garden in four parts, split by water channels around a central pool and planted with roses and cypress. Colonists come to sit by the water and calm down.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_Garden</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>40</Mass>
      <Beauty>28</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Pars_Garden</li>
    </researchPrerequisites>
    <building>
      <joyKind>Meditative</joyKind>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <JobDef>
    <defName>HE_SitInGarden</defName>
    <driverClass>JobDriver_SitFacingBuilding</driverClass>
    <reportString>resting in the garden.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>4</joyMaxParticipants>
    <joyKind>Meditative</joyKind>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>
  <JoyGiverDef>
    <defName>HE_Garden</defName>
    <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
    <baseChance>3</baseChance>
    <requireChair>false</requireChair>
    <thingDefs>
      <li>HE_Pars_Garden</li>
    </thingDefs>
    <jobDef>HE_SitInGarden</jobDef>
    <joyKind>Meditative</joyKind>
    <requiredCapacities>
      <li>Sight</li>
    </requiredCapacities>
  </JoyGiverDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Pars_PostLamp</defName>
    <label>post station lamp</label>
    <description>A pierced bronze lamp on a tall post, the kind hung at every royal post station so riders can find it in the dark.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_PostLamp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.6)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <costList>
      <WoodLog>10</WoodLog>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>5</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Pars_RoyalPost</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>1</fuelConsumptionRate>
        <fuelCapacity>10</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(255,170,90,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
  </ThingDef>
  <ThingDef ParentName="BenchBase">
    <defName>HE_Pars_CarpetLoom</defName>
    <label>carpet loom</label>
    <description>An upright wooden loom strung with warp threads, with balls of dyed wool hanging from its beam. It knots cloth or wool into Parsian carpets.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_CarpetLoom</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.25</staticSunShadowHeight>
    <costList>
      <WoodLog>80</WoodLog>
    </costList>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>2600</WorkToBuild>
      <MaxHitPoints>140</MaxHitPoints>
      <Flammability>1</Flammability>
      <Cleanliness>-2</Cleanliness>
      <Mass>30</Mass>
    </statBases>
    <size>(2,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>HE_Pars_CarpetLoom</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <RecipeDef>
    <defName>HE_Pars_WeaveCarpet</defName>
    <label>weave a Parsian carpet</label>
    <description>Knot 60 cloth or wool into one Parsian carpet.</description>
    <jobString>Weaving a carpet.</jobString>
    <workAmount>9000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
            <li>WoolSheep</li>
            <li>WoolAlpaca</li>
            <li>WoolMuffalo</li>
            <li>WoolBison</li>
            <li>WoolMegasloth</li>
          </thingDefs>
        </filter>
        <count>60</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>WoolSheep</li>
        <li>WoolAlpaca</li>
        <li>WoolMuffalo</li>
        <li>WoolBison</li>
        <li>WoolMegasloth</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HE_Pars_Carpet>1</HE_Pars_Carpet>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkillLearnFactor>0.5</workSkillLearnFactor>
    <recipeUsers>
      <li>HE_Pars_CarpetLoom</li>
    </recipeUsers>
    <researchPrerequisite>HE_Pars_CarpetLoom</researchPrerequisite>
  </RecipeDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Pars_FireAltar</defName>
    <label>fire altar</label>
    <description>A stepped altar of white stone whose fire must never go out. The priests feed it fragrant wood day and night, and the household gathers around its warmth.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_FireAltar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.48)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>70</costStuffCount>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2600</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>10</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsTemperature</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Pars_SatrapLaw</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2</fuelConsumptionRate>
        <fuelCapacity>20</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.4</fireSize>
        <offset>(0,0,0.32)</offset>
      </li>
      <li Class="CompProperties_HeatPusher">
        <heatPerSecond>6</heatPerSecond>
        <heatPushMaxTemperature>26</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,180,100,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Pars_Lamassu</defName>
    <label>lamassu</label>
    <description>A winged bull with a crowned human head, carved in stone to guard the gates of kings. It is carved with five legs, so that it stands still from the front and strides from the side.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_Lamassu</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1.64)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.6</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>240</costStuffCount>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>20</Mass>
      <Beauty>32</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Pars_TenThousand</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>HE_Pars_NaftThrower_Gun</defName>
    <label>naft siphon</label>
    <description>The turning top of the naft thrower.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_NaftThrower_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.7</AccuracyShort>
      <AccuracyMedium>0.4</AccuracyMedium>
      <AccuracyLong>0.2</AccuracyLong>
      <RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>30</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>HE_Naft_Pars</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>18.9</range>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <burstShotCount>4</burstShotCount>
        <soundCast>HE_Shot_Naft</soundCast>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Pars_NaftThrower</defName>
    <label>naft thrower</label>
    <description>A bronze tank of naft, the burning oil of the eastern wells, with a long siphon that sprays fire in short bursts. Its reach is short, but whatever it touches burns. Fill it with chemfuel: one unit makes one burst.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Pars_NaftThrower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>280</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>60</Mass>
      <Beauty>-4</Beauty>
      <ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>90</Steel>
      <BlocksSandstone>40</BlocksSandstone>
      <Chemfuel>30</Chemfuel>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>HE_Pars_NaftThrower_Gun</turretGunDef>
      <turretBurstCooldownTime>4.5</turretBurstCooldownTime>
      <turretTopDrawSize>2</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>HE_Pars_NaftThrower</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Naft</fuelLabel>
        <fuelGizmoLabel>Naft</fuelGizmoLabel>
        <outOfFuelMessage>Needs chemfuel</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>40</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
