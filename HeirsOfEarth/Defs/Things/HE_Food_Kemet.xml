<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MealCooked">
    <defName>HE_Kemet_Bread</defName>
    <label>date bread</label>
    <description>A round loaf of emmer wheat baked with dates and honey, served with onions, a lump of soft cheese and a cup of thin beer.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Items/HE_Kemet_Bread</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>21</MarketValue>
      <WorkToMake>500</WorkToMake>
      <Nutrition>0.9</Nutrition>
      <Mass>0.44</Mass>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFineMeal</tasteThought>
      <optimalityOffsetFeedingAnimals>-25</optimalityOffsetFeedingAnimals>
    </ingestible>
    <tradeTags>
      <li>HE_KemetGoods</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>6</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Kemet</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <RecipeDef ParentName="CookMealBase">
    <defName>HE_Cook_Kemet_Bread</defName>
    <label>cook date bread</label>
    <description>Cook date bread.</description>
    <jobString>Cooking date bread.</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>FoodRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>FoodRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <HE_Kemet_Bread>1</HE_Kemet_Bread>
    </products>
    <workSkill>Cooking</workSkill>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <researchPrerequisite>HE_Kemet_Bread</researchPrerequisite>
    <recipeUsers>
      <li>FueledStove</li>
      <li>ElectricStove</li>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>
