    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Hellas_Asclepion</defName>
    <label>asclepion</label>
    <description>A small marble altar to the healer god, with herbs smouldering in a bronze bowl and the snake-wound rod beside it. Beds within six cells get +4% tend quality and +3% immunity gain speed.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Hellas_Asclepion</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.25)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>6</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Hellas_Hippocratic</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <MedicalTendQualityOffset>0.04</MedicalTendQualityOffset>
          <ImmunityGainSpeedFactor>0.03</ImmunityGainSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>6</maxDistance>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2.5</glowRadius>
        <glowColor>(255,176,96,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>HE_Hellas_Lithobolos_Gun</defName>
    <label>throwing arm</label>
    <description>The turning top of the lithobolos.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Hellas_Lithobolos_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.3</AccuracyTouch>
      <AccuracyShort>0.6</AccuracyShort>
      <AccuracyMedium>0.7</AccuracyMedium>
      <AccuracyLong>0.6</AccuracyLong>
      <RangedWeapon_Cooldown>4.6</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>30</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>HE_Stone_Lithobolos</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>36.9</range>
        <minRange>5.9</minRange>
        <burstShotCount>1</burstShotCount>
        <soundCast>HE_Shot_Trebuchet</soundCast>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Hellas_Lithobolos</defName>
    <label>lithobolos</label>
    <description>A torsion stone thrower on a marble platform. Its arm hurls a stone the size of a head that breaks bones and shields alike. It cannot hit anything closer than six cells and is slow, but it reaches very far. Feed it stone chunks: one chunk makes ten stones.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Hellas_Lithobolos</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>340</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <WorkToBuild>9500</WorkToBuild>
      <Mass>60</Mass>
      <Beauty>-4</Beauty>
      <ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <WoodLog>100</WoodLog>
      <Steel>50</Steel>
      <BlocksMarble>40</BlocksMarble>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>HE_Hellas_Lithobolos_Gun</turretGunDef>
      <turretBurstCooldownTime>4.6</turretBurstCooldownTime>
      <turretTopDrawSize>2</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>HE_Hellas_Lithobolos</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Stones</fuelLabel>
        <fuelGizmoLabel>Stones</fuelGizmoLabel>
        <outOfFuelMessage>Needs stone chunks</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>ChunkGranite</li>
            <li>ChunkLimestone</li>
            <li>ChunkMarble</li>
            <li>ChunkSandstone</li>
            <li>ChunkSlate</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>40</fuelCapacity>
        <fuelMultiplier>10</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Hellas_Lectern</defName>
    <label>lamp-lit lectern</label>
    <description>A tall lectern of olive wood with an electric reading lamp, where one reads aloud and the others take notes. Placed near a research bench and powered, it speeds up research by 6%.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Hellas_Lectern</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <costList>
      <Steel>30</Steel>
      <WoodLog>40</WoodLog>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>6</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Hellas_Works</li>
    </researchPrerequisites>
    <building />
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.06</ResearchSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>8</maxDistance>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
      <li Class="HeirsOfEarth.HeirsAgeExt">
        <nation>HE_Hellas</nation>
        <age>4</age>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>
</Defs>
