<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>HE_Pars_Kaftan</defName>
    <label>silk kaftan</label>
    <description>A long open coat of red silk lined with cotton, embroidered at the hems and closed with a gold sash. Warm on the plateau at night and splendid at court.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>HeirsOfEarth/Apparel/HE_Pars_Kaftan</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <statBases>
      <WorkToMake>5200</WorkToMake>
      <Mass>1.4</Mass>
      <EquipDelay>2</EquipDelay>
      <MaxHitPoints>140</MaxHitPoints>
      <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.55</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.45</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.04</SocialImpact>
    </equippedStatOffsets>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags Inherit="False">
      <li>HE_ParsGoods</li>
      <li>Clothing</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>HeirsOfEarth/Apparel/Worn/Body/HE_Pars_Kaftan</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>HE_ParsApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>HE_Pars_Kaftan</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
      </li>
    </modExtensions>
  </ThingDef>
