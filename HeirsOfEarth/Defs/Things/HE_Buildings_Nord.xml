    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>130</costStuffCount>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
