  <ThingDef ParentName="BuildingBase">
    <defName>HE_Nord_Sauna</defName>
    <label>sauna</label>
    <description>A small pine bath house with a stone stove and benches. Colonists sweat out their worries here.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Nord_Sauna</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(3,2)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>180</costStuffCount>
    <costList>
      <BlocksGranite>30</BlocksGranite>
    </costList>
    <statBases>
