<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_CouncilHall</defName>
    <label>council hall of the heirs</label>
    <description>A great round table of polished stone under a ring of nine banners, one for every heir nation, with a seat for each envoy. Once it stands, you can call the World Council from the Heirs tab once per quadrum.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_CouncilHall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(5,5)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>400</costStuffCount>
    <costList>
      <Steel>150</Steel>
      <Gold>60</Gold>
      <Cloth>120</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToBuild>40000</WorkToBuild>
      <Beauty>40</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_WorldCouncil</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <building>
      <isInert>true</isInert>
    </building>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>HE_Trebuchet_Gun</defName>
    <label>trebuchet arm</label>
    <description>The throwing arm and counterweight of a trebuchet.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Trebuchet_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.1</AccuracyTouch>
      <AccuracyShort>0.3</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.4</AccuracyLong>
      <RangedWeapon_Cooldown>12</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>60</Mass>
      <Flammability>0.8</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>HE_Boulder_Trebuchet</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>56.9</range>
        <minRange>19.9</minRange>
        <requireLineOfSight>false</requireLineOfSight>
        <forcedMissRadius>4.9</forcedMissRadius>
        <burstShotCount>1</burstShotCount>
        <soundCast>HE_Shot_Trebuchet</soundCast>
        <consumeFuelPerShot>1</consumeFuelPerShot>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Trebuchet</defName>
    <label>trebuchet</label>
    <description>A counterweight trebuchet on a bed of rammed earth. A crew member must man it; it then hurls boulders over walls at enemies far out of bow range, smashing what they land on. It cannot hit anything closer than twenty cells, misses often and reloads slowly, but nothing an heir can build reaches further before the age of gunpowder. Fed with stone chunks: one chunk makes one boulder.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Trebuchet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(2.4,0.5,2.2)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>520</MaxHitPoints>
      <Flammability>1</Flammability>
      <WorkToBuild>14000</WorkToBuild>
      <Mass>120</Mass>
      <Beauty>-6</Beauty>
      <ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <WoodLog>320</WoodLog>
      <Steel>60</Steel>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>HE_Trebuchet_Gun</turretGunDef>
      <turretBurstWarmupTime>3</turretBurstWarmupTime>
      <turretBurstCooldownTime>12</turretBurstCooldownTime>
      <turretTopDrawSize>3.6</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>HE_Trebuchet</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Boulders</fuelLabel>
        <fuelGizmoLabel>Boulders</fuelGizmoLabel>
        <outOfFuelMessage>Needs stone chunks</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>ChunkGranite</li>
            <li>ChunkLimestone</li>
            <li>ChunkMarble</li>
            <li>ChunkSandstone</li>
            <li>ChunkSlate</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>12</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Embassy</defName>
    <label>embassy</label>
    <description>A hall to receive the envoys of the heir nations: a desk for letters and seals, chairs for guests and a banner stand for every nation. With an embassy you can sign science exchanges and defensive alliances, and every nation you hold a treaty with grows a little fonder of you each month. One is enough.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Embassy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.6,0.4,2.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(3,3)</size>
    <stuffCategories>
      <li>Stony</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>180</costStuffCount>
    <costList>
      <Cloth>60</Cloth>
      <Gold>10</Gold>
      <Silver>200</Silver>
    </costList>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Beauty>12</Beauty>
      <Flammability>0.6</Flammability>
      <Mass>120</Mass>
    </statBases>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Embassies</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <isInert>true</isInert>
    </building>
  </ThingDef>
</Defs>
