<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>HE_Albion_Shako</defName>
    <label>shako</label>
    <description>A tall stiff cap with a brass plate and a short plume. It makes a soldier look half a head taller.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>HeirsOfEarth/Apparel/HE_Albion_Shako</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>30</costStuffCount>
    <costList>
      <Steel>5</Steel>
    </costList>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <Mass>0.4</Mass>
      <EquipDelay>1</EquipDelay>
      <MaxHitPoints>80</MaxHitPoints>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.03</SocialImpact>
    </equippedStatOffsets>
    <thingCategories>
      <li>Headgear</li>
    </thingCategories>
    <tradeTags Inherit="False">
      <li>HE_AlbionGoods</li>
      <li>Clothing</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>HeirsOfEarth/Apparel/Worn/HE_Albion_Shako</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>HE_AlbionApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>HE_Albion_Redcoat</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
    </modExtensions>
  </ThingDef>
