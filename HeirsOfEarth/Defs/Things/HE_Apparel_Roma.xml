<Defs>
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>HE_Roma_Lorica</defName>
    <label>lorica segmentata</label>
    <description>Overlapping iron bands laced over a leather harness. It turns blades well, though the wearer walks a little slower.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>HeirsOfEarth/Apparel/HE_Roma_Lorica</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <Mass>9</Mass>
      <EquipDelay>2</EquipDelay>
      <MaxHitPoints>240</MaxHitPoints>
      <StuffEffectMultiplierArmor>0.82</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.3</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags Inherit="False">
      <li>HE_RomaGoods</li>
      <li>Clothing</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>HeirsOfEarth/Apparel/Worn/Body/HE_Roma_Lorica</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>HE_RomaApparel</li>
        <li>MedievalMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>HE_Roma_Lorica</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Roma</nation>
      </li>
    </modExtensions>
  </ThingDef>
