<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>HE_Pars_Archive</defName>
    <label>Parsian book of roads</label>
    <description>A heavy book bound in red leather: the stations of the royal road, the laws of every province, the rates of every toll and a long list of who owes favours to whom. Studying it at a culture table teaches a great deal about Pars.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Items/HE_Pars_Archive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>220</MarketValue>
      <Mass>0.6</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>HE_ParsGoods</li>
    </tradeTags>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Pars</nation>
        <knowledge>25</knowledge>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
