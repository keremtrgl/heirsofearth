  <ThingDef ParentName="BuildingBase">
    <defName>HE_Yamato_Rack</defName>
    <label>katana rack</label>
    <description>A lacquered rack holding swords in their scabbards. A proud display of a house's blades.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Yamato_Rack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1.25)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <costList>
      <Steel>20</Steel>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>20</Mass>
