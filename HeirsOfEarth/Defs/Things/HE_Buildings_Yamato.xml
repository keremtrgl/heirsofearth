<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Yamato_Torii</defName>
    <label>torii gate</label>
    <description>A tall red gate of two pillars and two lintels. Walking beneath it, people lower their voices.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Yamato_Torii</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,2.25)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <size>(3,1)</size>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>160</costStuffCount>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>7000</WorkToBuild>
      <Mass>30</Mass>
      <Beauty>20</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Yamato_Torii</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Yamato</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Yamato_Lantern</defName>
    <label>stone lantern</label>
    <description>A carved stone lantern with a small flame inside. It lights a garden path softly through the night.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Yamato_Lantern</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2600</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>6</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Yamato_TeaHouse</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>1.2</fuelConsumptionRate>
        <fuelCapacity>10</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(252,197,133,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Yamato</nation>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Yamato_TeaTable</defName>
    <label>tea table</label>
    <description>A low dark table set with an iron kettle and four cups. Colonists kneel around it for a quiet cup of tea.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Yamato_TeaTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>2600</WorkToBuild>
      <Mass>40</Mass>
      <Beauty>4</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Yamato_TeaHouse</li>
    </researchPrerequisites>
    <building>
      <joyKind>Social</joyKind>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Yamato</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Yamato_Dojo</defName>
    <label>dojo training post</label>
    <description>A post wrapped in straw bundles. Colonists strike it again and again to train their sword arm.</description>
