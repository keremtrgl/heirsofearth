<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Albion_SteamEngine</defName>
    <label>steam engine</label>
    <description>A wood-fired boiler driving a beam engine and a dynamo. It produces more power than a simple generator, and plenty of noise and smoke.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_SteamEngine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.9</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <costList>
      <Steel>160</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <BlocksGranite>30</BlocksGranite>
    </costList>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Mass>40</Mass>
      <Beauty>-10</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>HE_Albion_SteamEngine</li>
    </researchPrerequisites>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-1400</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>WoodFiredGenerator_Ambience</soundAmbientProducingPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>26</fuelConsumptionRate>
        <fuelCapacity>90</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(217,112,33,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>6</heatPerSecond>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Albion_PubTable</defName>
    <label>pub table</label>
    <description>A long, scarred oak table with tankards of ale, a game of cards and a dartboard on the post. Colonists gather here to drink, argue and lose at darts.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_PubTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(3,2)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>90</costStuffCount>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>60</Mass>
      <Beauty>4</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Albion_Pub</li>
    </researchPrerequisites>
    <building>
      <joyKind>Social</joyKind>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BenchBase">
    <defName>HE_Albion_TextileMill</defName>
    <label>textile mill</label>
    <description>A powered loom with an iron frame, a belt wheel and a roll of cloth. It weaves any wool into tweed, a warm and hard-wearing fabric.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_TextileMill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <costList>
      <Steel>120</Steel>
      <WoodLog>60</WoodLog>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>3500</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1</Flammability>
      <Cleanliness>-2</Cleanliness>
      <Mass>40</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>HE_Albion_TextileMill</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <RecipeDef>
    <defName>HE_Albion_WeaveTweed</defName>
    <label>weave tweed</label>
    <description>Weave 50 wool of any kind into 50 tweed.</description>
    <jobString>Weaving tweed.</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Wools</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Wools</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <HE_Albion_Tweed>50</HE_Albion_Tweed>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>HE_Albion_TextileMill</li>
    </recipeUsers>
    <researchPrerequisite>HE_Albion_TextileMill</researchPrerequisite>
  </RecipeDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Albion_GasLamp</defName>
    <label>gas lamp</label>
    <description>A cast-iron street lamp with a glass lantern. In the cities gas from the works keeps it burning all night; here a small burner fed from the power grid does the same.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_GasLamp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.8)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <costList>
      <Steel>45</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>4</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Albion_SteamPower</li>
