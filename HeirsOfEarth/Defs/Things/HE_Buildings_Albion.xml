  <ThingDef ParentName="BaseWeaponTurret">
    <defName>HE_Albion_FieldCannon_Gun</defName>
    <label>cannon</label>
    <description>The turning top of the field cannon.</description>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_FieldCannon_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.2</AccuracyTouch>
      <AccuracyShort>0.5</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.45</AccuracyLong>
      <RangedWeapon_Cooldown>7</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>30</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>HE_Shell_FieldCannon</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>40.9</range>
        <minRange>7.9</minRange>
        <burstShotCount>1</burstShotCount>
        <soundCast>HE_Shot_Cannon</soundCast>
        <consumeFuelPerShot>1</consumeFuelPerShot>
        <forcedMissRadius>1.9</forcedMissRadius>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Albion_FieldCannon</defName>
    <label>field cannon</label>
    <description>A bronze cannon on a wooden carriage behind a ring of sandbags. Each shell bursts where it lands. It cannot fire at anything closer than eight cells, and the gunners need time to swab and reload. Steel is cast into shells: four steel make one shell.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_FieldCannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>60</Mass>
      <Beauty>-4</Beauty>
      <ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>160</Steel>
      <WoodLog>60</WoodLog>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>HE_Albion_FieldCannon_Gun</turretGunDef>
      <turretBurstCooldownTime>7</turretBurstCooldownTime>
      <turretTopDrawSize>2</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>HE_Albion_FieldCannon</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shells</fuelLabel>
        <fuelGizmoLabel>Shells</fuelGizmoLabel>
        <outOfFuelMessage>Needs steel for shells</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>20</fuelCapacity>
        <fuelMultiplier>0.25</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Albion_TelegraphOffice</defName>
    <label>telegraph office</label>
    <description>A desk with a brass telegraph key, a sounder and a battery of cells, wired to a mast outside. While it has power it sends greetings to the other nations every quadrum: +1 goodwill with each heir nation that is not hostile. Only one office counts.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_TelegraphOffice</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>3600</WorkToBuild>
      <Mass>20</Mass>
      <Beauty>2</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Albion_Works</li>
    </researchPrerequisites>
    <building />
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="HeirsOfEarth.CompProperties_HeirsTelegraph">
        <goodwill>1</goodwill>
        <intervalDays>15</intervalDays>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
      <li Class="HeirsOfEarth.HeirsAgeExt">
        <nation>HE_Albion</nation>
        <age>4</age>
      </li>
    </modExtensions>
    <tickerType>Normal</tickerType>
  </ThingDef>
</Defs>
