        <basePowerConsumption>30</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>11</glowRadius>
        <glowColor>(255,214,140,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Albion</nation>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Albion_GrandfatherClock</defName>
    <label>grandfather clock</label>
    <description>A tall case clock of carved oak with a brass pendulum, wound once a week. Its slow tick is the sound of a well-run house.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Albion_GrandfatherClock</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.8)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>90</costStuffCount>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>14</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
