      <li>HE_TianxiaGoods</li>
      <li>Clothing</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>HeirsOfEarth/Apparel/Worn/HE_Tianxia_Helmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>HE_TianxiaApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>HE_Tianxia_Guandao</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Tianxia</nation>
      </li>
    </modExtensions>
