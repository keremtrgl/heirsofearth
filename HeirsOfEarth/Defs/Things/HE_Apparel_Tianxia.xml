    <label>lamellar helmet</label>
    <description>A rounded iron helmet with a tall plume tube and a curtain of small plates hanging over the neck.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>HeirsOfEarth/Apparel/HE_Tianxia_Helmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <WorkToMake>4200</WorkToMake>
      <Mass>2.2</Mass>
      <EquipDelay>1</EquipDelay>
