<Defs>
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>HE_Hellas_Corinthian</defName>
    <label>Corinthian helmet</label>
    <description>A bronze helmet beaten from a single sheet, with a nose guard, long cheek pieces and a horsehair crest. It hides the face completely.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>HeirsOfEarth/Apparel/HE_Hellas_Corinthian</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>55</costStuffCount>
    <statBases>
      <WorkToMake>4600</WorkToMake>
      <Mass>2.4</Mass>
      <EquipDelay>1</EquipDelay>
      <MaxHitPoints>120</MaxHitPoints>
      <StuffEffectMultiplierArmor>0.62</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.02</SocialImpact>
    </equippedStatOffsets>
    <thingCategories>
      <li>Headgear</li>
    </thingCategories>
    <tradeTags Inherit="False">
      <li>HE_HellasGoods</li>
      <li>Clothing</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>HeirsOfEarth/Apparel/Worn/HE_Hellas_Corinthian</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>HE_HellasApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>HE_Hellas_Hoplite</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Hellas</nation>
      </li>
    </modExtensions>
  </ThingDef>
