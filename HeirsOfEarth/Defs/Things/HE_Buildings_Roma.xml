<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HE_Roma_Standard</defName>
    <label>legion standard</label>
    <description>A red standard of the legions on a tall pole, crowned with a golden eagle. Soldiers stand straighter when they see it.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>HeirsOfEarth/Buildings/HE_Roma_Standard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2,1.8)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <costList>
      <Cloth>30</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>8</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>HE_Heritage</designationCategory>
    <researchPrerequisites>
      <li>HE_Roma_Standard</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="HeirsOfEarth.HeirsCultureExt">
        <nation>HE_Roma</nation>
      </li>
    </modExtensions>
  </ThingDef>
